// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  username        String?          @unique // For admin/superadmin login
  name            String?
  phone           String?          @unique
  companyName     String?          // For contractor / business owner identification
  age             Int?
  password        String?          // Hashed password for admin authentication
  role            String           @default("PLAYER") // "CORE_ADMIN", "SUPERADMIN", "ADMIN", "OUTLET_ADMIN", "PLAYER"
  brandId         String?          // Tenant isolation: Which brand this admin belongs to
  brand           Brand?           @relation("BrandAdmins", fields: [brandId], references: [id], onDelete: SetNull)
  outletId        String?          // Outlet-specific admin linkage
  outlet          Outlet?          @relation(fields: [outletId], references: [id], onDelete: SetNull)
  
  // ZuzyRun / Mouzy Runner Specific Player Fields
  homeOutletId      String?          @map("home_outlet_id")
  homeOutlet        Outlet?          @relation("PlayerHomeOutlet", fields: [homeOutletId], references: [id], onDelete: SetNull)
  highScore         Int              @default(0) @map("high_score")
  totalScore        BigInt           @default(0) @map("total_score")
  dailyHighScore    Int              @default(0) @map("daily_high_score")
  dailyLastPlayedAt String?          @map("daily_last_played_at") // 'YYYY-MM-DD' in Asia/Kolkata timezone
  dob               String?
  lastPlayedAt      DateTime?        @default(now()) @map("last_played_at")

  emailVerified   Boolean          @default(false)
  image           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  
  sessions        Session[]
  accounts        Account[]
  invoicesClaimed Invoice[]
  gameplayCredits GameplayCredit[]
  gameSessions    GameSession[]
  qrTokens        QrToken[]
  tokensOwned     Token[]          @relation("TokenOwner")
  weeklyGiftsWon  WeeklySpecialGift[]
  brandMemberships BrandMember[]
  userCoupons     UserCoupon[]
  dailyWins       DailyWinner[]

  @@index([brandId, role])
  @@index([outletId])
  @@index([totalScore(sort: Desc)])
  @@index([homeOutletId, dailyLastPlayedAt, dailyHighScore(sort: Desc)])
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                    String    @id
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

// ----------------------------------------------------
// MULTI-TENANT & CLIENT ONBOARDING MODELS (RAILROLLS)
// ----------------------------------------------------

model Brand {
  id            String           @id @default(uuid())
  slug          String           @unique // e.g. "railrolls", "popular"
  name          String           // e.g. "Popular Electricals"
  gameName      String?          // e.g. "Sparky Run", "Railrolls Dash"
  webhookSecret String?          // For POS webhooks (matching x-webhook-secret)
  apiKey        String?          @unique // API key for external integrations
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  
  admins        User[]           @relation("BrandAdmins")
  outlets       Outlet[]
  invoices      Invoice[]
  credits       GameplayCredit[]
  sessions      GameSession[]
  tokens        QrToken[]
  weeklyGifts   WeeklySpecialGift[]
  tokensV1      Token[]
  members       BrandMember[]
  userCoupons   UserCoupon[]
  dailyWinners  DailyWinner[]
}

model Token {
  tokenId     String    @id @map("token_id") // e.g. 'GLB-3AD5N99Z1K'
  type        String    @default("global")
  livesLeft   Int       @default(3) @map("lives_left")
  status      String    @default("active") // 'active' | 'expired' | 'revoked'
  ownerPhone  String?   @map("owner_phone")
  owner       User?     @relation("TokenOwner", fields: [ownerPhone], references: [phone], onDelete: SetNull)
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  brandId     String?   @map("brand_id")
  brand       Brand?    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@map("tokens")
  @@index([ownerPhone])
  @@index([status])
  @@index([brandId])
}

model Outlet {
  id          String   @id // e.g. 'in-ke-parappa', 'uae-karama'
  name        String   // e.g. 'Mouzy Parappanangadi'
  place       String   // e.g. 'Parappanangadi'
  countryCode String   @default("+91") @map("country_code") // e.g. '+91', '+971', '+966', '+974'
  status      String   @default("active") // 'active' | 'inactive'
  brandId     String?  @map("brand_id")
  brand       Brand?   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")

  admins      User[]
  players     User[]   @relation("PlayerHomeOutlet")
  members     BrandMember[]
  userCoupons UserCoupon[]
  dailyWinners DailyWinner[]

  @@map("outlets")
  @@index([status])
  @@index([brandId])
}

model BrandMember {
  id              String    @id @default(uuid())
  
  userId          String    @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  brandId         String    @map("brand_id")
  brand           Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  
  homeOutletId    String?   @map("home_outlet_id")
  homeOutlet      Outlet?   @relation(fields: [homeOutletId], references: [id], onDelete: SetNull)
  
  registeredVia   String    @default("QR_TOKEN") @map("registered_via") // "QR_TOKEN", "MANUAL", "BYOD", "INVOICE"
  initialTokenId  String?   @map("initial_token_id")
  
  totalScore      BigInt    @default(0) @map("total_score")
  highScore       Int       @default(0) @map("high_score")
  dailyHighScore  Int       @default(0) @map("daily_high_score")
  dailyLastPlayed String?   @map("daily_last_played") // YYYY-MM-DD
  
  createdAt       DateTime  @default(now()) @map("created_at")
  lastActiveAt    DateTime  @default(now()) @map("last_active_at")

  @@unique([userId, brandId])
  @@map("brand_members")
  @@index([brandId, homeOutletId])
  @@index([brandId, createdAt])
}

enum InvoiceStatus {
  UNCLAIMED
  CLAIMED
  EXPIRED
  CANCELLED
}

model Invoice {
  id              String        @id @default(uuid())
  brandId         String
  brand           Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  outletCode      String?       // restID from Railrolls POS
  invoiceNumber   String        // orderID from Railrolls POS
  customerPhone   String?       // Customer phone recorded on bill (if present)
  itemsCount      Int           @default(1)
  maxPlaysAllowed Int           @default(3) // itemsCount * 3 plays
  amount          Decimal?      @db.Decimal(10, 2)
  status          InvoiceStatus @default(UNCLAIMED)
  claimedByUserId String?
  claimedByUser   User?         @relation(fields: [claimedByUserId], references: [id])
  claimedAt       DateTime?
  rawPayload      Json?         // Full raw JSON properties from POS webhook
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([brandId, invoiceNumber])
  @@index([brandId, customerPhone, status])
  @@index([brandId, status])
}

model GameplayCredit {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandId         String
  brand           Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  totalGranted    Int       @default(0)
  playsRemaining  Int       @default(0)
  sourceType      String    @default("INVOICE") // "INVOICE", "QR", "DAILY"
  sourceReference String?   // Invoice number or QR code
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, brandId, playsRemaining])
}

model GameSession {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandId      String
  brand        Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  sessionToken String    @unique // Single-use cryptographic token for anti-cheat
  score        Int       @default(0)
  duration     Int?      // Duration in seconds
  isCompleted  Boolean   @default(false)
  startedAt    DateTime  @default(now())
  completedAt  DateTime?

  @@index([brandId, score])
  @@index([userId, brandId])
}

model QrToken {
  id              String       @id @default(uuid())
  code            String       @unique // e.g. "PET-9XK2-MP8A", "122ERF"
  
  // Brand isolation
  brandId         String
  brand           Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  gameSlug        String       @default("sparky-run")
  
  initialLives    Int          @default(3)
  livesRemaining  Int          @default(3)
  status          String       @default("ACTIVE") // 'ACTIVE' | 'EXHAUSTED' | 'REVOKED'
  
  userId          String?      // Bound user/customer ID when claimed
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  claimedAt       DateTime?
  lastPlayedAt    DateTime?
  expiresAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([brandId, code])
  @@index([code])
  @@index([status])
}

model RewardCoupon {
  id            String    @id @default(cuid())
  brandSlug     String    // e.g. "popular-electricals-qatar"
  customerId    String?   // User ID
  customerName  String    // e.g. "Hussain Al-Ansari"
  customerPhone String    // e.g. "+974 55123456"
  rewardId      String    // e.g. "rw_5k", "rw_10k", "rw_16k", "rw_30k"
  rewardTitle   String    // e.g. "Keychain / Pen / Cap"
  couponCode    String    @unique // e.g. "PET-8492-QAT"
  discountValue String?   // e.g. "STORE GIFT"
  redeemedCoins Int       // Coins cost (e.g. 5000, 10000, 16000, 30000)
  status        String    @default("PENDING") // "PENDING" | "REDEEMED" | "CANCELLED"
  claimedAt     DateTime  @default(now())
  redeemedAt    DateTime?
  redeemedBy    String?   // Admin / Cashier user ID
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([brandSlug, status])
  @@index([customerPhone, brandSlug])
}

model WeeklyWinner {
  id            String    @id @default(cuid())
  brandSlug     String    // e.g. "popular-electricals-qatar"
  weekLabel     String    // e.g. "19 Oct - 25 Oct 2026"
  weekStart     DateTime  // Sunday 00:00 AST
  weekEnd       DateTime  // Saturday 23:59:59 AST
  winnerUserId  String?
  winnerName    String    // e.g. "Hussain"
  winnerPhone   String?   // e.g. "+974 70257079"
  winningScore  Int       // Highest single game score or total
  rank          Int       @default(1)
  claimed       Boolean   @default(false)
  claimedAt     DateTime?
  rewardTitle   String?   // e.g. "Weekly Champion Prize"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([brandSlug, weekStart])
  @@index([brandSlug, rank])
}

model WeeklySpecialGift {
  id            String    @id @default(cuid())
  brandSlug     String
  weekLabel     String    // e.g., "18 Oct - 24 Oct 2026"
  weekStart     DateTime
  weekEnd       DateTime
  giftType      String    @default("LULU_100_QAR")
  isClaimed     Boolean   @default(false)
  claimedAt     DateTime?
  winnerUserId  String?
  couponCode    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  brand         Brand     @relation(fields: [brandSlug], references: [slug])
  user          User?     @relation(fields: [winnerUserId], references: [id])

  @@unique([brandSlug, weekLabel, giftType])
  @@index([brandSlug, isClaimed])
}

// ----------------------------------------------------
// STORE REWARDS & COUPON REDEMPTION (MOUZY & MULTI-TENANT)
// ----------------------------------------------------

model UserCoupon {
  id             BigInt    @id @default(autoincrement())
  couponCode     String    @unique @map("coupon_code") @db.VarChar(32) // e.g. 'MZ-7K2X9A'
  brandSlug      String    @default("mouzy") @map("brand_slug") @db.VarChar(64)
  brandId        String?   @map("brand_id")
  brand          Brand?    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  
  userPhone      String    @map("user_phone") @db.VarChar(32)
  user           User?     @relation(fields: [userPhone], references: [phone], onDelete: Cascade)
  
  playerName     String    @map("player_name") @db.VarChar(255)
  rewardLabel    String    @map("reward_label") @db.VarChar(255) // e.g. 'Free Regular Avilmilk'
  pointsSpent    Int       @map("points_spent")
  redeemed       Boolean   @default(false)
  redeemedAt     DateTime? @map("redeemed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  
  outletId       String?   @map("outlet_id") @db.VarChar(64)
  outlet         Outlet?   @relation(fields: [outletId], references: [id], onDelete: SetNull)

  @@map("user_coupons")
  @@index([userPhone])
  @@index([couponCode])
  @@index([brandSlug])
  @@index([brandId])
}

// ----------------------------------------------------
// MULTI-TENANT DAILY WINNERS & TOPPERS HISTORY
// ----------------------------------------------------

model DailyWinner {
  id             BigInt    @id @default(autoincrement())
  brand          String    @db.VarChar(64) // e.g. 'mouzy', 'sparky'
  brandId        String?   @map("brand_id")
  brandRel       Brand?    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  
  outletId       String    @map("outlet_id") @db.VarChar(64)
  outlet         Outlet    @relation(fields: [outletId], references: [id], onDelete: Cascade)
  
  winDate        String    @map("win_date") @db.VarChar(10) // 'YYYY-MM-DD' in Asia/Kolkata
  rank           Int
  winId          String    @unique @map("win_id") @db.VarChar(64) // e.g. 'DW-PARAPPA-A56A72'
  
  userPhone      String    @map("user_phone") @db.VarChar(32)
  user           User?     @relation(fields: [userPhone], references: [phone], onDelete: Cascade)
  
  playerName     String    @map("player_name") @db.VarChar(255)
  dailyHighScore Int       @map("daily_high_score")
  totalScore     BigInt    @map("total_score")
  
  rewardMetadata Json      @default("{}") @map("reward_metadata") // e.g. { "label": "Free Supreme Avil Milk", "rank": 1 }
  redeemed       Boolean   @default(false)
  redeemedAt     DateTime? @map("redeemed_at")
  capturedAt     DateTime  @default(now()) @map("captured_at")

  @@map("daily_winners")
  @@index([brand, outletId, winDate], name: "idx_daily_winners_brand_outlet_date")
  @@index([brand, userPhone], name: "idx_daily_winners_brand_phone")
  @@index([winId], name: "idx_daily_winners_code")
  @@index([winDate])
}
