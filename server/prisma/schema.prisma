// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  username        String?          @unique // For admin/superadmin login
  name            String?
  phone           String?          @unique
  companyName     String?          // For contractor / business owner identification
  age             Int?
  password        String?          // Hashed password for admin authentication
  role            String           @default("PLAYER") // "CORE_ADMIN", "SUPERADMIN", "ADMIN", "PLAYER"
  brandId         String?          // Tenant isolation: Which brand this admin belongs to
  brand           Brand?           @relation("BrandAdmins", fields: [brandId], references: [id], onDelete: SetNull)
  emailVerified   Boolean          @default(false)
  image           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  
  sessions        Session[]
  accounts        Account[]
  invoicesClaimed Invoice[]
  gameplayCredits GameplayCredit[]
  gameSessions    GameSession[]
  qrTokens        QrToken[]
  weeklyGiftsWon  WeeklySpecialGift[]

  @@index([brandId, role])
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                    String    @id
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

// ----------------------------------------------------
// MULTI-TENANT & CLIENT ONBOARDING MODELS (RAILROLLS)
// ----------------------------------------------------

model Brand {
  id            String           @id @default(uuid())
  slug          String           @unique // e.g. "railrolls", "popular"
  name          String           // e.g. "Popular Electricals"
  gameName      String?          // e.g. "Sparky Run", "Railrolls Dash"
  webhookSecret String?          // For POS webhooks (matching x-webhook-secret)
  apiKey        String?          @unique // API key for external integrations
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  
  admins        User[]           @relation("BrandAdmins")
  invoices      Invoice[]
  credits       GameplayCredit[]
  sessions      GameSession[]
  tokens        QrToken[]
  weeklyGifts   WeeklySpecialGift[]
}

enum InvoiceStatus {
  UNCLAIMED
  CLAIMED
  EXPIRED
  CANCELLED
}

model Invoice {
  id              String        @id @default(uuid())
  brandId         String
  brand           Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  outletCode      String?       // restID from Railrolls POS
  invoiceNumber   String        // orderID from Railrolls POS
  customerPhone   String?       // Customer phone recorded on bill (if present)
  itemsCount      Int           @default(1)
  maxPlaysAllowed Int           @default(3) // itemsCount * 3 plays
  amount          Decimal?      @db.Decimal(10, 2)
  status          InvoiceStatus @default(UNCLAIMED)
  claimedByUserId String?
  claimedByUser   User?         @relation(fields: [claimedByUserId], references: [id])
  claimedAt       DateTime?
  rawPayload      Json?         // Full raw JSON properties from POS webhook
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([brandId, invoiceNumber])
  @@index([brandId, customerPhone, status])
  @@index([brandId, status])
}

model GameplayCredit {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandId         String
  brand           Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  totalGranted    Int       @default(0)
  playsRemaining  Int       @default(0)
  sourceType      String    @default("INVOICE") // "INVOICE", "QR", "DAILY"
  sourceReference String?   // Invoice number or QR code
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, brandId, playsRemaining])
}

model GameSession {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandId      String
  brand        Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  sessionToken String    @unique // Single-use cryptographic token for anti-cheat
  score        Int       @default(0)
  duration     Int?      // Duration in seconds
  isCompleted  Boolean   @default(false)
  startedAt    DateTime  @default(now())
  completedAt  DateTime?

  @@index([brandId, score])
  @@index([userId, brandId])
}

model QrToken {
  id              String       @id @default(uuid())
  code            String       @unique // e.g. "PET-9XK2-MP8A", "122ERF"
  
  // Brand isolation
  brandId         String
  brand           Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  gameSlug        String       @default("sparky-run")
  
  initialLives    Int          @default(3)
  livesRemaining  Int          @default(3)
  status          String       @default("ACTIVE") // 'ACTIVE' | 'EXHAUSTED' | 'REVOKED'
  
  userId          String?      // Bound user/customer ID when claimed
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  claimedAt       DateTime?
  lastPlayedAt    DateTime?
  expiresAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([brandId, code])
  @@index([code])
  @@index([status])
}

model RewardCoupon {
  id            String    @id @default(cuid())
  brandSlug     String    // e.g. "popular-electricals-qatar"
  customerId    String?   // User ID
  customerName  String    // e.g. "Hussain Al-Ansari"
  customerPhone String    // e.g. "+974 55123456"
  rewardId      String    // e.g. "rw_5k", "rw_10k", "rw_16k", "rw_30k"
  rewardTitle   String    // e.g. "Keychain / Pen / Cap"
  couponCode    String    @unique // e.g. "PET-8492-QAT"
  discountValue String?   // e.g. "STORE GIFT"
  redeemedCoins Int       // Coins cost (e.g. 5000, 10000, 16000, 30000)
  status        String    @default("PENDING") // "PENDING" | "REDEEMED" | "CANCELLED"
  claimedAt     DateTime  @default(now())
  redeemedAt    DateTime?
  redeemedBy    String?   // Admin / Cashier user ID
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([brandSlug, status])
  @@index([customerPhone, brandSlug])
}

model WeeklyWinner {
  id            String    @id @default(cuid())
  brandSlug     String    // e.g. "popular-electricals-qatar"
  weekLabel     String    // e.g. "19 Oct - 25 Oct 2026"
  weekStart     DateTime  // Sunday 00:00 AST
  weekEnd       DateTime  // Saturday 23:59:59 AST
  winnerUserId  String?
  winnerName    String    // e.g. "Hussain"
  winnerPhone   String?   // e.g. "+974 70257079"
  winningScore  Int       // Highest single game score or total
  rank          Int       @default(1)
  claimed       Boolean   @default(false)
  claimedAt     DateTime?
  rewardTitle   String?   // e.g. "Weekly Champion Prize"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([brandSlug, weekStart])
  @@index([brandSlug, rank])
}

model WeeklySpecialGift {
  id            String    @id @default(cuid())
  brandSlug     String
  weekLabel     String    // e.g., "18 Oct - 24 Oct 2026"
  weekStart     DateTime
  weekEnd       DateTime
  giftType      String    @default("LULU_100_QAR")
  isClaimed     Boolean   @default(false)
  claimedAt     DateTime?
  winnerUserId  String?
  couponCode    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  brand         Brand     @relation(fields: [brandSlug], references: [slug])
  user          User?     @relation(fields: [winnerUserId], references: [id])

  @@unique([brandSlug, weekLabel, giftType])
  @@index([brandSlug, isClaimed])
}
